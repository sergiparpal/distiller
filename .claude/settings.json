{
  "permissions": {
    "defaultMode": "acceptEdits",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(make check)",
      "Bash(make verify)",
      "Bash(make test)",
      "Bash(make test-red)",
      "Bash(make lint)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(git status *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Edit(/.venv/**)",
      "Edit(/.git/info/**)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)",
      "Edit(claim-ledger.toml)",
      "Edit(/.claude/hooks/**)",
      "Read(/.claude/settings.local.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/phase)",
      "Edit(/.claude/tests-phase.log)",
      "Edit(/.claude/stop-state.json)",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push *)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(gh *)",
      "Bash(rm* /*)",
      "Bash(rm* ~*)",
      "Bash(rm* *$HOME*)",
      "Bash(rm* ../*)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(find /* -delete*)",
      "Bash(find ~* -delete*)"
    ]
  },
  "autoMemoryEnabled": false,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["pypi.org"]
    },
    "credentials": {
      "envVars": [
        { "name": "OPENROUTER_API_KEY", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/freeze_tests.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_reads.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_reads.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format_edited.py"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check_on_stop.py"],
            "timeout": 600,
            "statusMessage": "Running make verify"
          }
        ]
      }
    ]
  }
}
