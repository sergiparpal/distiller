# make install creates .venv and the pre-commit hook; make check runs the harness.
# Bash, for the process substitution in make protected: /bin/sh is dash here.
SHELL := /bin/bash
PYTHON ?= python3
BIN := .venv/bin
# The commit that make protected compares docs/SPEC.md with.
REF ?= HEAD

.PHONY: install check verify format lint imports types test test-red test-hooks \
  audit secrets lock protected

install:
	$(PYTHON) -m venv .venv
	$(BIN)/python -m pip install --quiet --requirement requirements-dev.txt
	$(BIN)/pre-commit install

# CI runs make check: make verify, then pip-audit, the one step that needs the
# network and that nothing the agent may change without asking can turn red.
check: verify audit

# What the Stop hook runs after every turn, inside bwrap and offline.
verify: format lint imports types test secrets

format:
	$(BIN)/ruff format --check

lint:
	$(BIN)/ruff check

imports:
	PYTHONPATH=src $(BIN)/lint-imports

types:
	$(BIN)/pyright

test:
	$(BIN)/coverage erase
	$(BIN)/coverage run -m pytest
	$(BIN)/coverage combine --quiet
	$(BIN)/coverage report

# How the tests phase runs the tests: no tracebacks, which would show src/.
test-red:
	$(BIN)/python -m pytest --tb=no -rfE

# The contract tests of the Claude Code hooks in .claude/hooks; make check
# leaves them out.
test-hooks:
	$(BIN)/python -m pytest .claude/hooks/tests

audit:
	$(BIN)/pip-audit --strict --no-deps --disable-pip --progress-spinner off \
	  --requirement requirements.txt --requirement requirements-dev.txt

secrets:
	$(BIN)/pre-commit run gitleaks-history --hook-stage manual --all-files

# Rewrites requirements-dev.txt: the tools and everything they need, pinned.
lock:
	rm -rf .lock-venv
	$(PYTHON) -m venv .lock-venv
	.lock-venv/bin/python -m pip install --quiet --requirement requirements-dev.in
	{ echo "# Generated by make lock from requirements-dev.in: do not edit."; \
	  echo "-r requirements.txt"; \
	  .lock-venv/bin/python -m pip freeze --exclude coverage --exclude defusedxml; \
	} > requirements-dev.txt
	rm -rf .lock-venv

# Fails if the Bet, the problem and the non-goals, or the [core] and "format"
# lines of the slices, differ from REF, or if either comes out empty now. Both
# checks always run, so one difference does not hide the other.
protected:
	@bet() { sed -n '/^## Bet/,/^## Constraints/p'; }; \
	core() { sed -n '/^### Slice 1/,/^## Technical sheet/p' | grep -e '\[core\]' -e '"format"'; }; \
	failed=0; \
	diff <(git show $(REF):docs/SPEC.md | bet) <(bet < docs/SPEC.md) \
	  || { echo "protected: the Bet, the problem or the non-goals differ from $(REF)"; failed=1; }; \
	diff <(git show $(REF):docs/SPEC.md | core) <(core < docs/SPEC.md) \
	  || { echo "protected: a [core] or format line differs from $(REF)"; failed=1; }; \
	if [ -z "$$(bet < docs/SPEC.md)" ]; then \
	  echo "protected: docs/SPEC.md has no Bet section"; failed=1; fi; \
	if [ -z "$$(core < docs/SPEC.md)" ]; then \
	  echo "protected: docs/SPEC.md has no [core] or format line in its slices"; failed=1; fi; \
	exit $$failed
